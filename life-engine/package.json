{
  "name": "life-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Life Engine — a provably-fair HTML5 iGaming product in the crash family.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "rtp:report": "tsx scripts/rtp-report.ts",
    "verify": "tsx engine/verify.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "build:single": "vite build --config vite.singlefile.config.ts"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/express": "^5.0.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
